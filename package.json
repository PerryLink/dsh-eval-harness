{
  "name": "dsh-eval-pack",
  "version": "0.2.0",
  "description": "Public/synthetic eval-pack lint and deterministic JSON grader; not a validated benchmark.",
  "type": "module",
  "main": "./lib/plugin/index.js",
  "types": "./lib/plugin/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/plugin/index.d.ts",
      "default": "./lib/plugin/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "README-zh.md",
    "README-es.md",
    "README-pt.md",
    "README-hi.md",
    "docs/assets",
    "SECURITY.md",
    "PRIVACY.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "TROUBLESHOOTING.md",
    "screenshots.json",
    "icon.svg",
    "samples"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "demo": {
      "sample": "samples/quickstart/input",
      "prompt": "我用自带样例跑一次评测：3 个样本里过了几个、哪个没过、pass@3 是多少？",
      "expect": "samples/quickstart/expected/result.json",
      "screenshot": "docs/assets/quickstart.png",
      "reads": [
        "用户指定的评测包 JSON、样本 JSON 与运行结果 JSON（样例：samples/quickstart/input）"
      ],
      "writes": [],
      "network": false,
      "external": []
    },
    "capabilities": [
      "tools:register"
    ],
    "labels": []
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.4.0",
    "node": ">=24.9.0 <25"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "prepublishOnly": "node scripts/check-npm-name.mjs",
    "gate": "node scripts/gate.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "eval",
    "harness",
    "perrylink",
    "testing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-eval-pack.git"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <5.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3 <0.4.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2"
  },
  "homepage": "https://perrylink.github.io/dsh-plugins/packages/dsh-eval-pack.html",
  "bugs": {
    "url": "https://github.com/PerryLink/dsh-eval-pack/issues"
  },
  "icon": "icon.svg",
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
